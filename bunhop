-- ==========================================
-- BUTTON FUNCTIONALITY
-- ==========================================
local isChecking = false

CheckButton.MouseButton1Click:Connect(function()
    if isChecking then return end
    isChecking = true

    local key = KeyInput.Text
    if key == "" then
        CheckButton.Text = "Please enter a key!"
        uwait(2)
        CheckButton.Text = "Check key"
        isChecking = false
        return
    end

    CheckButton.Text = "Checking..."
    uwait(1.5)

    -- Replace this with real Luarmor validation later
    if key == "test" then
        CheckButton.Text = "Success!"
        CheckButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        uwait(1)
        ScreenGui:Destroy()
    else
        CheckButton.Text = "Invalid Key"
        CheckButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        uwait(2)
        CheckButton.Text = "Check key"
        CheckButton.BackgroundColor3 = Color3.fromRGB(139, 0, 0)
        isChecking = false
    end
end)

