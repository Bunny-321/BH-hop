-- Wait for game to load
if not game:IsLoaded() then
    game.Loaded:Wait()
end

-- Universal wait (falls back to legacy wait on old executors)
local function uwait(t)
    if task and task.wait then
        task.wait(t)
    else
        wait(t)
    end
end

-- Universal clipboard
local function copyToClipboard(text)
    if setclipboard then
        pcall(setclipboard, text)
        return true
    elseif toclipboard then
        pcall(toclipboard, text)
        return true
    elseif set_clipboard then
        pcall(set_clipboard, text)
        return true
    end
    return false
end

-- Create the ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "KeySystemGui"
ScreenGui.ResetOnSpawn = false

-- Parent with fallback (critical for Arceus X and mobile executors)
local ok = pcall(function()
    ScreenGui.Parent = game:GetService("CoreGui")
end)
if not ok then
    ScreenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

-- Remove any old duplicate GUI
if ScreenGui.Parent then
    local old = ScreenGui.Parent:FindFirstChild("KeySystemGui")
    if old and old ~= ScreenGui then
        old:Destroy()
    end
end

